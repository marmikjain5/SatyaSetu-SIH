# SatyaDrishti (SatyaSetu-SIH) Environment Template

VITE_ENABLE_GMAIL_DISPATCH=true
VITE_GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GMAIL_CLIENT_SECRET=your-google-client-secret
VITE_GMAIL_REFRESH_TOKEN=your-google-refresh-token
VITE_GMAIL_SENDER_EMAIL=your-testing-email@gmail.com
VITE_GMAIL_RECIPIENT_OVERRIDE=your-recipient-test-email@gmail.com

# SatyaDrishti Database Environment Configuration
# Default local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/satyadrishti

# Or for hosted PostgreSQL (Supabase, Neon, AWS RDS, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/database_name
